# PostgreSQL (пароль: латиница и цифры, он попадает в URL подключения)
POSTGRES_USER=chronella
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chronella

# Backend
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# ENCRYPTION_KEY (ключ Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# Google OAuth (client id и secret из Google Cloud Console)
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:8080/google-callback