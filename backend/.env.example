# PostgreSQL
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me

# Backend (ENCRYPTION_KEY — ключ Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DATABASE_URL=postgresql+psycopg://change-me:change-me@db:5432/change-me
SECRET_KEY=change-me
